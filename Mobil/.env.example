# =============================================================
# TARAS Mobile — environment template
# Copy to `.env` and fill values. Never commit `.env`.
# Used at build time by app.config.js → extra.{apiHost, ...}
# =============================================================

# --- API target ----------------------------------------------
# Set USE_LOCAL_API=true to use API_HOST_LOCAL (Metro/dev box),
# false to use API_HOST_AWS (production backend).
USE_LOCAL_API=

# Local dev (Backend running on your machine — `npm run dev`):
#   On simulator:                   http://localhost:3000
#   On physical Android on Wi-Fi:   http://<your-laptop-LAN-IP>:3000
API_HOST_LOCAL=

# Production backend (HTTPS via CDN/proxy → backend host).
API_HOST_AWS=

# --- Demo credentials (one-tap login from DemoOnlyLoginScreen) ---
# Local Demo Credentials (offline mode)
DEMO_USERNAME=
DEMO_PASSWORD=

# AWS Demo Credentials (for quick server login)
AWS_DEMO_USERNAME=
AWS_DEMO_PASSWORD=

# --- Release mode --------------------------------------------
# Demo-only release: "true" → DemoOnlyLoginScreen (2 CTA only, register hidden).
# Default false (standard login + register).
DEMO_ONLY=
