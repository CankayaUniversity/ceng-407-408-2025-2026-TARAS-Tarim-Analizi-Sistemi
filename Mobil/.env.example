# =============================================================
# TARAS Mobile — environment template
# Copy to `.env` and fill values. Never commit `.env`.
# Used at build time by app.config.js → extra.{apiHost, ...}
# =============================================================

# --- API target ----------------------------------------------
# Set USE_LOCAL_API=true to use API_HOST_LOCAL (Metro/dev box),
# false to use API_HOST_AWS (production backend).
USE_LOCAL_API=

# Local dev (Backend running on your machine — `npm run dev`):
#   On simulator:                   http://localhost:3000
#   On physical Android on Wi-Fi:   http://<your-laptop-LAN-IP>:3000
API_HOST_LOCAL=

# Production backend (HTTPS via CDN/proxy → backend host).
API_HOST_AWS=

# --- Demo ----------------------------------------------------
# Offline local demo needs NO config — the "Local Demo" button enters an on-device
# sandbox directly (display name is hardcoded "Demo"). No embedded credentials.
#
# Live-server demo: credentials are NO LONGER embedded in the app. The server issues
# a token for the shared demo account via /auth/demo-login (backend DEMO_READONLY_USER_ID,
# which also makes that account read-only). This flag only shows/hides the "Live Demo"
# button. true/false.
LIVE_DEMO_ENABLED=

# --- Release mode --------------------------------------------
# Demo-only release: "true" → DemoOnlyLoginScreen (2 CTA only, register hidden).
# Default false (standard login + register).
DEMO_ONLY=
