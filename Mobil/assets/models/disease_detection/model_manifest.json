{
  "name": "mobilenetv3_large_distilled_v1",
  "version": "1.1.0",
  "file": "disease_model.tflite",
  "format": "tflite",
  "precision": "fp16",
  "size_mb": 8.5,
  "params_m": 4.21,
  "runtime": "react-native-fast-tflite",
  "min_runtime_version": "1.6.0",
  "delegates_preferred": ["nnapi", "core-ml", "default"],
  "input": {
    "name": "input",
    "shape": [1, 224, 224, 3],
    "dtype": "float32",
    "layout": "NHWC",
    "preprocessing": {
      "resize_shortest_side": 256,
      "center_crop": 224,
      "normalize_mean": [0.485, 0.456, 0.406],
      "normalize_std": [0.229, 0.224, 0.225],
      "color_order": "RGB"
    }
  },
  "output": {
    "name": "logits",
    "shape": [1, 10],
    "dtype": "float32",
    "semantics": "unnormalized_logits",
    "postprocessing": {
      "divide_by_temperature": 0.8359,
      "then_apply": "softmax",
      "confidence_threshold": 0.5
    }
  },
  "classes": [
    {"index": 0, "name": "bacterial_spot",         "crops": ["tomato", "pepper"]},
    {"index": 1, "name": "early_blight",           "crops": ["tomato", "potato"]},
    {"index": 2, "name": "healthy",                "crops": ["tomato", "potato", "pepper"]},
    {"index": 3, "name": "late_blight",            "crops": ["tomato", "potato"]},
    {"index": 4, "name": "leaf_mold",              "crops": ["tomato"]},
    {"index": 5, "name": "mosaic_virus",           "crops": ["tomato"]},
    {"index": 6, "name": "septoria_leaf_spot",     "crops": ["tomato"]},
    {"index": 7, "name": "spider_mites",           "crops": ["tomato"]},
    {"index": 8, "name": "target_spot",            "crops": ["tomato"]},
    {"index": 9, "name": "yellow_leaf_curl_virus", "crops": ["tomato"]}
  ],
  "benchmarks": {
    "val_f1_pv": 0.9980,
    "val_acc_pv": 0.9985,
    "field_f1_plantdoc": 0.5922,
    "field_acc_plantdoc": 0.6196,
    "distilled_from": "swin_tiny_pv_pd_rw_sm_v4 (27.5M params, field F1 0.7063)",
    "distillation_gap_field_f1": 0.1141,
    "vs_teammate_swin_small_field_f1": 0.0743,
    "ref_mobile_cpu_inference_ms": {
      "pixel_7_tensor_nnapi": 8,
      "pixel_4_nnapi": 15,
      "iphone_13_coreml": 6,
      "iphone_se_2022_coreml": 10
    },
    "tflite_fp16_vs_onnx_fp32": {
      "f1_drop": 0.0023,
      "pred_agreement_pct": 99.68
    },
    "int8_rejected": {
      "size_mb": 4.8,
      "f1_drop": 0.1075,
      "pred_agreement_pct": 69.7,
      "reason": "MobileNetV3 distilled weights do not survive post-training INT8; Hardswish+SE quantization error accumulates. Would need QAT (retraining) to recover."
    }
  },
  "ui_hints": {
    "uncertain_message_en": "Not confident. Please take a clearer photo of the leaf.",
    "uncertain_message_tr": "Emin degilim. Lutfen yapragin daha net bir fotografini cekin.",
    "max_fps": 30,
    "throttle_ms_between_inferences": 150,
    "lighting_ok_lux_min": 50
  },
  "v2_experiments": {
    "leaf_detector_cascade_2026_04_26": {
      "status": "rejected",
      "asset": "../leaf_detector/leaf_detector.tflite",
      "detector_map_50": 0.83,
      "detector_size_mb": 3.46,
      "f1_uplift_vs_center_crop": -0.1121,
      "n_test_images": 58,
      "n_classes_in_sample": 9,
      "ci_pp_estimate": 10,
      "padding_sweep": {
        "0.10": -11.21, "0.20": -10.80, "0.30": -10.31, "0.40": -9.22, "0.50": -7.86
      },
      "notes": "Negative or zero on PlantDoc-OD dedup'd test split. Padding sweep showed monotonic improvement as padding increases (smaller detector influence = less damage), but no ratio in 0.10-0.50 reached the +5pp gate. Trend implies pad=infinity converges to center-crop F1 (delta=0). Don't reintegrate without re-distilling classifier on detector-cropped data, or first running Lambda shadow logging to validate against real field uploads."
    }
  }
}
