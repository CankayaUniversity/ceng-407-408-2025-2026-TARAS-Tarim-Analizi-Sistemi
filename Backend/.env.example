# =============================================================
# TARAS Backend — environment template
# Copy to `.env` and fill values. Never commit `.env`.
# =============================================================

# --- Core ----------------------------------------------------
NODE_ENV=                           # development | production
PORT=
HOST=
JWT_SECRET=                         # 64+ char random; openssl rand -hex 32
JWT_EXPIRES_IN=
CORS_ORIGINS=                       # comma-separated origins, or * for all

# --- Database ------------------------------------------------
# Format: postgresql://USER:PASS@HOST:5432/DBNAME?schema=public&sslmode=disable
# Production (PG on the same host as backend): point at 127.0.0.1
# Local dev via SSH tunnel: also 127.0.0.1 with tunnel forwarding 5432
DATABASE_URL=

# --- AWS -----------------------------------------------------
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=                  # IAM user with S3 + Lambda invoke perms
AWS_SECRET_ACCESS_KEY=
LAMBDA_DISEASE_DETECTION_FUNCTION=

# --- Infra (used by Backend/taras.bat for SSH/SCP/deploy/health) ---
# AWS_EC2_IP name is historical — set to whatever host runs the backend.
# The bat scripts SSH/SCP to this address.
AWS_EC2_IP=
AWS_PUBLIC_URL=                     # https URL the public hits, e.g. via CDN/proxy

# --- MQTT (sensor ingestion) ---------------------------------
MQTT_BROKER_URL=
MQTT_TOPIC_PREFIX=

# --- LLM advisory --------------------------------------------
# Switch backend uses: "anthropic" (Haiku tool loop) or "groq" (Qwen fallback)
LLM_PROVIDER=
ANTHROPIC_API_KEY=                  # sk-ant-... (required if LLM_PROVIDER=anthropic)
GROQ_API_KEY=                       # gsk_...    (required if LLM_PROVIDER=groq)

# --- Demo read-only lockdown ---------------------------------
# Shared demo account protection (anti-griefing). Set to the user_id (UUID) of the
# shared demo account (e.g. llm_test). When set, ALL writes by that user are rejected
# server-side (403) — create/delete/edit, gateway pairing, irrigation, AND the AI
# assistant's chat persistence (the LLM still answers, nothing is saved). Disease
# scans stay allowed. Keyed on user_id, so renaming the account does NOT bypass it.
# Leave BLANK to disable entirely (no effect on normal production users).
DEMO_READONLY_USER_ID=

# --- Seed / test ---------------------------------------------
# Password baked into the test_user seeded by `npm run seed:test-user`.
TEST_PASSWORD=

# --- Debug Mode (true/false) ---------------------------------
# Enables: verbose req/res logging, /api/debug/* endpoints, stack traces in errors.
# Also: skips MQTT broker connection (set to true for local/staging without real broker)
DEBUG_MODE=
